  "benchmark_config": {
    "name": "symbolic-decay_V_to_FFbar",
    "version": "1.0.0",
    "description": "Tree-level width of a massive neutral vector into a Dirac fermion\npair: (a) pure vector coupling L = g V_mu psibar gamma^mu psi, (b)\ngeneral V/A coupling L = V_mu psibar gamma^mu (gV - gA gamma_5) psi\n(the Z/Z' structure; the axial part carries an extra beta^2\nthreshold suppression). Polarization averaging and the massive-\nfermion (1+2x), (1-4x) factors are the content. Exact numeric widths\n(GeV) + closed-form formulas in results/answer.json. Ground truth\nderived and verified in ground_truth/derivation.py (Barger-Phillips;\nLangacker arXiv:0801.1345).\n",
    "default_harness": "orchestral/anthropic",
    "default_loadout": "core_only",
    "default_variant": "unguided",
    "ground_truth": {
      "dir": "<hepbench>/benchmarks/symbolic/decay_V_to_FFbar/ground_truth"
    },
    "checks": "<hepbench>/benchmarks/symbolic/_shared/checks.py",
    "artifacts": {
      "keep_full": [
        ".json",
        ".py",
        ".md",
        ".wl",
        ".txt"
      ],
      "keep_root": [
        "todos.md"
      ]
    },
    "rubric": {
      "type": "stagewise",
      "stages": [
        {
          "id": "answer_present",
          "description": "results/answer.json exists with all four answer fields.",
          "weight": 0.04,
          "checks": [
            {
              "json_with_keys": {
                "file": "results/answer.json",
                "required_keys": [
                  "part_a_width_gev",
                  "part_a_width_formula",
                  "part_b_width_gev",
                  "part_b_width_formula"
                ]
              }
            }
          ]
        },
        {
          "id": "a_order_of_magnitude",
          "gating": false,
          "description": "Part (a) width within half a decade (NDA-passable rung).",
          "weight": 0.06,
          "checks": [
            {
              "answer_value": {
                "file": "results/answer.json",
                "field": "part_a_width_gev",
                "reference": "ground_truth/truth.json",
                "log10_tol": 0.5
              }
            }
          ]
        },
        {
          "id": "a_within_10pct",
          "gating": false,
          "description": "Part (a) width within 10%.",
          "weight": 0.09,
          "checks": [
            {
              "answer_value": {
                "file": "results/answer.json",
                "field": "part_a_width_gev",
                "reference": "ground_truth/truth.json",
                "rel_tol": 0.1
              }
            }
          ]
        },
        {
          "id": "a_within_1pct",
          "gating": false,
          "description": "Part (a) width within 1%.",
          "weight": 0.12,
          "checks": [
            {
              "answer_value": {
                "file": "results/answer.json",
                "field": "part_a_width_gev",
                "reference": "ground_truth/truth.json",
                "rel_tol": 0.01
              }
            }
          ]
        },
        {
          "id": "a_formula",
          "gating": false,
          "description": "Part (a) closed form matches at sampled (g, mV, mf).",
          "weight": 0.21,
          "checks": [
            {
