! forward_flux.cmnd -- part of HEPBench (GPL v3).
!
! Canonical forward parent-flux run card for the llp_forward family.
! pp @ 13.6 TeV, SOFT-QCD INELASTIC only. Every LLP parent species is made
! STABLE and harvested at its PRODUCTION momentum; the BSM emissions
!   pseudoscalar  M -> mu nu phi      (K, D, Ds)
!   vector        V -> mu+ mu- phi    (rho0, omega, phi(1020); J/psi, psi(2S))
! are applied DOWNSTREAM in the LLP-production step. Pythia never sees
! phi (it is BSM). Key difference from Hostert et al. tauALP (arXiv:2507.15271,
! the forward event-generation reference): there mesons are forced to decay to
! taus and the tau is harvested; here we harvest the parent meson itself.
!
! WHY inelastic-only (no Onia here): SoftQCD:inelastic (codes 101,103,104,105,
! 106 -- all soft processes EXCEPT elastic 102) yields K, open charm D/Ds (from
! the soft charm tail), and the light vectors rho/omega/phi cleanly, with
! sigmaGen = the inelastic cross section (verified: 79.7 mb ~ the pinned
! sigma_inel = 80 mb). CHARMONIUM (J/psi, psi(2S)) requires the Onia processes,
! which are HARD -- Pythia warns "should not combine softQCD processes with hard
! ones" and the mix throws BeamRemnants errors. So charmonium is generated in a
! SEPARATE, independently-normalized sample (forward_onia.cmnd) and is optional:
! it is null-by-rate for the forward reach and carries the forward-quarkonium
! modeling systematic. Settings verified against QCDSoftProcesses.xml.

Tune:pp = 14                      ! Monash 2013 min-bias/UE tune
Beams:idA = 2212
Beams:idB = 2212
Beams:frameType = 1               ! collider frame
Beams:eCM = 13600.                ! 13.6 TeV   [PUBLIC_PIN: sqrt(s)]

SoftQCD:inelastic = on            ! codes 101,103,104,105,106 (no elastic)

! LLP parent mesons made stable -> final-state, harvested (finals_only) at
! production. Full set kept for a consistent harvest list; J/psi & psi(2S) are
! populated only when forward_onia.cmnd is added. IDs match parents.py.
211:mayDecay = off                ! pi+-  (only for m_phi < 0.034 GeV lobe)
321:mayDecay = off                ! K+-
411:mayDecay = off                ! D+-
431:mayDecay = off                ! Ds+-
113:mayDecay = off                ! rho0
223:mayDecay = off                ! omega
333:mayDecay = off                ! phi(1020)
443:mayDecay = off                ! J/psi   (needs forward_onia.cmnd)
100443:mayDecay = off             ! psi(2S) (needs forward_onia.cmnd)

! Quiet / bookkeeping.
Print:quiet = on
Next:numberCount = 0
Init:showChangedSettings = off
Init:showChangedParticleData = off
Init:showProcesses = off
Init:showMultipartonInteractions = off
Check:event = off
